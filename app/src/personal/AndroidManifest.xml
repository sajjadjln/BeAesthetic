<?xml version="1.0" encoding="utf-8"?>
<!-- The personal build has both languages, so the launcher label can be fixed to either (D194).
     The Bazaar build is Persian only and keeps the one alias in main (D207). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity-alias
            android:name="app.lantern.LauncherFa"
            android:targetActivity="app.lantern.MainActivity"
            android:label="@string/app_name_fa"
            android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="app.lantern.LauncherEn"
            android:targetActivity="app.lantern.MainActivity"
            android:label="@string/app_name_en"
            android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
