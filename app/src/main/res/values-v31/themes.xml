<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the system splash is only the night and the lantern, held until the first frame;
         the Compose "Gather" splash (D190) takes over from there. -->
    <style name="Theme.Lantern" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/window_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_lantern</item>
    </style>
</resources>
