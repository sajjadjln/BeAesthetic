<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the system splash is only the night color, held until the first frame (no icon, so
         the sword doesn't flash before the castle); the Compose pixel splash (D219) takes over from there. -->
    <style name="Theme.Lantern" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">#050B12</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
